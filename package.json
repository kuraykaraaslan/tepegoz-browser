{
  "name": "tepegoz-browser",
  "version": "0.0.0",
  "private": true,
  "description": "Agentic automation browser — observable, security-by-design, local-first (cloud-optional). Windows 11 primary.",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:electron": "node scripts/test-electron.mjs",
    "coverage": "vitest run --coverage --config vitest.coverage.config.ts",
    "docs:links": "node scripts/check-doc-links.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "depcruise": "depcruise packages apps --config dependency-cruiser.cjs",
    "e2e": "turbo run build --filter=@tepegoz/desktop && playwright test",
    "eval": "turbo run build --filter=@tepegoz/desktop && playwright test --config playwright.eval.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@vitest/coverage-v8": "^3.2.6",
    "@types/node": "^22.10.2",
    "dependency-cruiser": "^16.8.0",
    "eslint": "^9.17.0",
    "eslint-plugin-i18next": "6.1.5",
    "prettier": "^3.4.2",
    "turbo": "2.5.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^3.2.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "better-sqlite3"
    ],
    "overrides": {
      "nanoid": ">=3.3.16",
      "postcss": ">=8.5.18",
      "tar": ">=7.5.7",
      "js-yaml": ">=4.3.1",
      "ip-address": ">=10.3.1",
      "fast-uri": ">=3.1.4",
      "vite": "^7.3.6"
    }
  }
}
