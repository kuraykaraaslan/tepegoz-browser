{
  "name": "tepegoz-browser",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "description": "Agentic automation browser — observable, security-by-design, local-first (cloud-optional). Windows 11 primary.",
  "author": "Kuray Karaaslan <kuraykaraaslan@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuraykaraaslan/tepegoz-browser.git"
  },
  "homepage": "https://github.com/kuraykaraaslan/tepegoz-browser#readme",
  "bugs": {
    "url": "https://github.com/kuraykaraaslan/tepegoz-browser/issues"
  },
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10"
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean:turbo": "node -e \"require('fs').rmSync('.turbo/cache',{recursive:true,force:true})\"",
    "coverage": "vitest run --coverage --config vitest.coverage.config.ts",
    "docs:links": "node scripts/check-doc-links.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "depcruise": "depcruise packages apps --config dependency-cruiser.cjs",
    "e2e": "turbo run build --filter=@tepegoz/desktop && playwright test",
    "eval": "turbo run build --filter=@tepegoz/desktop && playwright test --config playwright.eval.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tepegoz/i18n": "workspace:*",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^3.2.6",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^9.17.0",
    "eslint-plugin-i18next": "6.1.5",
    "prettier": "^3.4.2",
    "turbo": "2.9.14",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^3.2.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "better-sqlite3"
    ],
    "overrides": {
      "nanoid": ">=3.3.16",
      "postcss": ">=8.5.18",
      "tar": ">=7.5.21",
      "js-yaml": ">=4.3.1",
      "ip-address": ">=10.3.1",
      "fast-uri": ">=3.1.4",
      "vite": "^7.3.6",
      "esbuild": ">=0.25.0"
    }
  },
  "//devDependencies": "`@tepegoz/i18n` is a devDependency of the ROOT so the Playwright suite can import the real `IME_MATRIX` instead of keeping a second copy of it. A runner that carries its own cases stops testing the matrix the moment the matrix changes."
}
