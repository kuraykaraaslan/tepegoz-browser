# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
out/
build/
.turbo/
*.tsbuildinfo

# Native modules (rebuilt per-OS in CI)
*.node

# Throwaway Electron profiles from local debugging (`--user-data-dir=.something-profile`). These hold a
# live leveldb whose LOCK file cannot even be read while the app runs, which breaks `prettier --check`.
.*-profile/
# `spike-parked-render.spec.ts` names its throwaway profile by port, so the directory is different every
# run and cannot be cleaned by name after the fact. Left behind, they make `git status` dirty on a tree
# that only ran the tests.
.spike-bg-*/

# Capture output from the marketing-asset scripts (see scripts/README.md). Both take the output
# directory as `argv[2]` and fall back to these defaults, so a plain `node scripts/screenshots.mjs`
# leaves PNGs — and `record-agent.mjs` a multi-megabyte WebM — sitting untracked in the tree, one
# `git add .` away from landing binaries in history. The bytes that get PUBLISHED live in the website
# repo's `public/`, never here; what these write is scratch, and re-runnable.
# (The demo Electron profile is deliberately NOT in the repo — it is `C:\Users\Public\tepegoz-demo`,
# so the profile path the app prints on screen carries no username and no repo artifact name.)
.shots/
.recording/

# Test / coverage
coverage/
test-results/
playwright-report/
# Eval output is REGENERABLE, never a source of truth — a committed report goes stale the moment the
# scoring logic changes, and then it lies. The durable record is phases/ai-agent/eval-results.md.
# Regenerate: phases/ai-agent/eval-loop-runbook.md
agent-eval-report.json
agent-eval-runs/
*.log

# Secrets & local config (NEVER commit) — BYO keys live in OS keychain, not files
.env
.env.local
.env.*.local

# Packaged artifacts
/release/

# Agent-local state (Claude Code plugin cache, session scratch) — machine-specific, never source.
.claude/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json


.junk