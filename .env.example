# tepegoz-browser — environment (CONFIG ONLY; NEVER put secrets here)
#
# BYO API keys (Anthropic / OpenAI / Gemini) are entered at runtime and stored ENCRYPTED via the
# OS keychain (Electron safeStorage / Windows DPAPI) — NOT in env files, NOT in the bundle.
# These vars are optional config with safe defaults; missing ones do not crash local-first mode.

# Path to the local SQLite database (defaults to the app userData dir if empty)
SQLITE_PATH=

# Default port for the local MCP server surface (Phase 1b)
MCP_DEFAULT_PORT=

# Default policy decision when no rule matches: allow | deny | ask
POLICY_DEFAULT_DECISION=ask

# Optional managed proxy base URL (Phase 3). Empty = pure local-first (BYO-key).
TEPEGOZ_PROXY_URL=

# For local development only: BYO API keys (Anthropic / OpenAI / Gemini) are entered at runtime and stored ENCRYPTED via the OS keychain (Electron safeStorage / Windows DPAPI) — NOT in env files, NOT in the bundle.
ANTROPIC_API_KEY=
OPENAI_API_KEY=