# Normalize line endings to LF in the repo (matches .editorconfig); avoids CRLF churn cross-platform.
* text=auto eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.node binary
*.woff binary
*.woff2 binary

# Lockfile: keep diffs but treat as generated
pnpm-lock.yaml -diff linguist-generated=true
