    "@tepegoz/ext-agent": "workspace:*",
    "@tepegoz/ext-macros": "workspace:*",
    "@tepegoz/ext-popup-blocker": "workspace:*",
    "@tepegoz/ext-user-agent": "workspace:*",
    "@tepegoz/extension-catalog": "workspace:*",
    "@tepegoz/file-operations": "workspace:*",
    "@tepegoz/extension-host": "workspace:*",
    "@tepegoz/extension-sdk": "workspace:*",
    "@tepegoz/extensions-ui": "workspace:*",
    "@tepegoz/history-ui": "workspace:*",
    "@tepegoz/http": "workspace:*",
    "@tepegoz/human-input": "workspace:*",
    "@tepegoz/i18n": "workspace:*",
    "@tepegoz/journal-tools": "workspace:*",
    "@tepegoz/json-store": "workspace:*",
    "@tepegoz/libs": "workspace:*",
    "@tepegoz/local-inference": "workspace:*",
