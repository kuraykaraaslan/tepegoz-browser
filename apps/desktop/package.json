{
  "name": "@tepegoz/desktop",
  "version": "0.0.0",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:raw": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "icons": "node scripts/generate-icons.mjs",
    "rebuild": "electron-rebuild -f -o better-sqlite3",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@tepegoz/capability-plane": "workspace:*",
    "@tepegoz/credential-vault": "workspace:*",
    "@tepegoz/ext-agent": "workspace:*",
    "@tepegoz/ext-user-agent": "workspace:*",
    "@tepegoz/extension-sdk": "workspace:*",
    "@tepegoz/extensions-ui": "workspace:*",
    "@tepegoz/history-ui": "workspace:*",
    "@tepegoz/i18n": "workspace:*",
    "@tepegoz/json-store": "workspace:*",
    "@tepegoz/libs": "workspace:*",
    "@tepegoz/model-gateway": "workspace:*",
    "@tepegoz/nav-toolbar": "workspace:*",
    "@tepegoz/navigation": "workspace:*",
    "@tepegoz/omnibox": "workspace:*",
    "@tepegoz/orchestrator": "workspace:*",
    "@tepegoz/persistence": "workspace:*",
    "@tepegoz/security-policy": "workspace:*",
    "@tepegoz/settings-ui": "workspace:*",
    "@tepegoz/shared-types": "workspace:*",
    "@tepegoz/tab-strip": "workspace:*",
    "@tepegoz/tool-executor": "workspace:*",
    "@tepegoz/ui": "workspace:*",
    "@tepegoz/window-controls": "workspace:*",
    "better-sqlite3": "^11.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.1.16",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-vite": "^2.3.0",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
