{
  "name": "@tepegoz/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Tepegöz — agentic, security-by-design, local-first browser.",
  "author": "Kuray Karaaslan <kuraykaraaslan@gmail.com>",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:raw": "vite-node scripts/generate-extension-catalog.ts && electron-vite dev",
    "build": "vite-node scripts/generate-extension-catalog.ts && electron-vite build",
    "preview": "electron-vite preview",
    "generate:catalog": "vite-node scripts/generate-extension-catalog.ts",
    "icons": "node scripts/generate-icons.mjs",
    "rebuild": "electron-rebuild -f -o better-sqlite3",
    "package:dir": "electron-vite build && electron-builder --dir --config electron-builder.yml",
    "package:win": "electron-vite build && electron-builder --win --config electron-builder.yml",
    "package:mac": "electron-vite build && electron-builder --mac --config electron-builder.yml",
    "package:linux": "electron-vite build && electron-builder --linux --config electron-builder.yml",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "node-llama-cpp": "^3.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "3.23.8"
  },
  "//devDependencies": "@tepegoz/* workspace packages are bundled into out/ by electron-vite (they expose TS source via `exports`), so they are BUILD-TIME deps, not runtime node_modules deps. Keeping them here (not in `dependencies`) is what lets electron-builder package the app: it only collects production deps, and pnpm symlinks these to ../../packages/* (outside apps/desktop), which electron-builder cannot pack into the asar.",
  "devDependencies": {
    "@electron/rebuild": "^3.7.0",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.1",
    "@modelcontextprotocol/sdk": "1.22.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.1.16",
    "@tepegoz/agent-runtime": "workspace:*",
    "@tepegoz/bookmarks": "workspace:*",
    "@tepegoz/bookmarks-bar": "workspace:*",
    "@tepegoz/bookmarks-ui": "workspace:*",
    "@tepegoz/browser-chrome": "workspace:*",
