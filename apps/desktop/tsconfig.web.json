{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": { "@/*": ["src/renderer/src/*"] },
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["react", "react-dom", "vite/client"],
    "jsx": "react-jsx",
    "noEmit": true
  },
  "comment": "Renderer (untrusted UI): DOM libs, React; NO node types.",
  "include": ["src/renderer/**/*", "src/shared/**/*"]
}
